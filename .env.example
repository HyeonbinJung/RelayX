# ============================================
# RelayX — WhatsApp ↔ Discord bridge
# Copy this file to .env and fill in your own values.
# Never commit .env — it holds your bot token.
# ============================================

# Discord bot token (Discord Developer Portal → your app → Bot → Reset Token)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN

# ------------------------------------------------------
# Channel pairs (up to 10)
# A pair is active only when BOTH IDs are filled in.
# NAME is just a label for the logs.
# DISCORD_CHANNEL_ID : right-click the channel → Copy Channel ID (Developer Mode on)
# WHATSAPP_GROUP_ID  : run `npm run groups` and send a message in the group
# ------------------------------------------------------
PAIR_01_NAME=General
PAIR_01_DISCORD_CHANNEL_ID=
PAIR_01_WHATSAPP_GROUP_ID=

PAIR_02_NAME=
PAIR_02_DISCORD_CHANNEL_ID=
PAIR_02_WHATSAPP_GROUP_ID=

PAIR_03_NAME=
PAIR_03_DISCORD_CHANNEL_ID=
PAIR_03_WHATSAPP_GROUP_ID=

PAIR_04_NAME=
PAIR_04_DISCORD_CHANNEL_ID=
PAIR_04_WHATSAPP_GROUP_ID=

PAIR_05_NAME=
PAIR_05_DISCORD_CHANNEL_ID=
PAIR_05_WHATSAPP_GROUP_ID=

PAIR_06_NAME=
PAIR_06_DISCORD_CHANNEL_ID=
PAIR_06_WHATSAPP_GROUP_ID=

PAIR_07_NAME=
PAIR_07_DISCORD_CHANNEL_ID=
PAIR_07_WHATSAPP_GROUP_ID=

PAIR_08_NAME=
PAIR_08_DISCORD_CHANNEL_ID=
PAIR_08_WHATSAPP_GROUP_ID=

PAIR_09_NAME=
PAIR_09_DISCORD_CHANNEL_ID=
PAIR_09_WHATSAPP_GROUP_ID=

PAIR_10_NAME=
PAIR_10_DISCORD_CHANNEL_ID=
PAIR_10_WHATSAPP_GROUP_ID=

# ------------------------------------------------------
# Browser & session
# ------------------------------------------------------
# Path to an installed Chrome / Chromium (required)
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   /usr/bin/google-chrome
BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Folder that stores the WhatsApp login session (keep it private)
WHATSAPP_SESSION_DIR=.wwebjs_auth

# false = show the Chrome window (recommended for the first login)
# true  = run in the background once the session is saved
PUPPETEER_HEADLESS=false
